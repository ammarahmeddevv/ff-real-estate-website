# Copy this file to `.env.local` for local development.
# Set the same values in Vercel (Settings -> Environment Variables) for the live site.
# Full walkthrough: SETUP.md

# Full public URL of the site — https://, no trailing slash. Used for SEO tags,
# sitemap and social-share previews. Local dev: http://localhost:3000
# On Vercel, if this is left unset the site falls back to the deployment's own
# NEXT_PUBLIC_VERCEL_URL (e.g. your-app.vercel.app) instead of localhost — but
# set it explicitly to the final domain before launch so canonical URLs and the
# sitemap are stable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity project id from https://www.sanity.io/manage. Leave blank to run the
# site on its built-in fallback content (no CMS).
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Sanity dataset name. Almost always "production".
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API version (a date). Leave as-is unless a developer changes it.
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Sanity token with Editor (write) access. Required so the contact form can save
# leads and so `npm run seed` can write. Server-only — never prefix with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# Gmail address that sends lead-notification emails. Optional — if unset, leads
# are still saved in Sanity, just not emailed.
GMAIL_USER=f.f.realestate333@gmail.com

# 16-character Google App Password for GMAIL_USER (requires 2-Step Verification
# on that account). Optional; pairs with GMAIL_USER.
GMAIL_APP_PASSWORD=

# Where lead-notification emails are delivered. Defaults to GMAIL_USER if unset.
LEAD_NOTIFICATION_EMAIL=f.f.realestate333@gmail.com
