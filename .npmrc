# This repo lives in a folder whose name contains "&" ("F&F REAL ESTATE").
# npm runs lifecycle/`run` scripts through the platform shell; on Windows that is
# cmd.exe/PowerShell, which treats "&" as a command separator and breaks the path
# (scripts fail with "'F' is not recognized"). Routing scripts through bash (ships
# with Git for Windows) avoids this. Harmless on macOS/Linux, and the deploy
# target (Vercel/Linux) is unaffected. A bash shell must be on PATH locally.
script-shell=bash

# The Sanity test toolchain declares a stricter @types/node peer range than it
# needs. Without this, a plain `npm install` (e.g. on Vercel) fails with
# ERESOLVE. Safe here: the conflict is dev-only and the lockfile is valid.
legacy-peer-deps=true
